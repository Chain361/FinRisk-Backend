# ⚠️ เปิดแล้ว prompt, ผล tool (ชื่อโครงการ/ผู้ชนะ/งบประมาณ) และเนื้อความเอกสาร ปร.4/5/6
#    จะถูกส่งขึ้น LangSmith cloud — ตอนนี้เปิดได้เพราะยังเป็นข้อมูล mock (แผน §7 ทางเลือก A)
#    **ก่อนใช้กับข้อมูลจริงต้องทบทวนใหม่** (ปิด flag / LANGSMITH_HIDE_INPUTS / self-hosted)
LANGSMITH_TRACING=true
